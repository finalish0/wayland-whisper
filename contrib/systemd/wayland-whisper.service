[Unit]
Description=Local Whisper dictation for Wayland
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/git/wayland-whisper/.venv/bin/wayland-whisper run --whisper-model %h/.local/share/whisper/ggml-small.bin --vad-model %h/.local/share/silero-vad/silero_vad.onnx --language de
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
