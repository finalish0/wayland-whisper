#!/bin/sh
# Toggle / suspend / stop the warm wayland-whisper user service.
#
# Master switch: on | off (mirrors nerd-dictation-toggle):
#   - "on"  enables the service (warm daemon, microphone still closed) and
#           binds Ctrl+Space and the pad Enter key ("send") in Sway. "off"
#           disables everything so both keys go to the focused app again.
#   - Ctrl+Space (or no argument) opens/closes the microphone only.
#   - "send" (the pad Enter key) finishes the phrase being dictated, closes
#           the microphone, then presses Enter for the focused app.
set -eu

SERVICE=wayland-whisper.service
BIN="${BIN:-$HOME/git/wayland-whisper/.venv/bin/wayland-whisper}"
FLAGDIR="${FLAGDIR:-$HOME/.config/wayland-whisper}"
FLAG="$FLAGDIR/disabled"
LOG="${LOG:-$HOME/.local/state/wayland-whisper.log}"
SWAYBIND="${SWAYBIND:-$HOME/.config/sway/wayland-whisper.conf}"
TOGGLE_BIN="${TOGGLE_BIN:-$HOME/.local/bin/wayland-whisper-toggle}"
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
COOKIE="$RUNDIR/wayland-whisper.pid"
AHAKEY="${AHAKEY:-$HOME/git/ahakey-x1/ahakey.sh}"
AHAKEY_ENV="${AHAKEY_ENV:-$HOME/git/ahakey-x1/.env}"
FIFO="${FIFO:-$RUNDIR/ahakey-scroll}"
BIND_CMD="bindsym Ctrl+Space exec --no-startup-id $TOGGLE_BIN"

if [ -f "$FLAGDIR/env" ]; then
  # shellcheck disable=SC1091
  set -a
  . "$FLAGDIR/env"
  set +a
fi

# Pad Enter = "send" (AhaKey pad; device is machine-specific and lives in the
# AhaKey env). Bound only while the master switch is on, like the old
# nerd-dictation pad-enter.sh; unbound again when the master switch is off.
PAD_DEVICE="${PAD_DEVICE:-${AHAKEY_SWAY_DEVICE:-}}"
if [ -z "$PAD_DEVICE" ] && [ -f "$AHAKEY_ENV" ]; then
  PAD_DEVICE=$(awk -F= '/^AHAKEY_SWAY_DEVICE=/{print $2; exit}' "$AHAKEY_ENV")
fi
PAD_BIND_CMD=""
if [ -n "$PAD_DEVICE" ]; then
  PAD_BIND_CMD="bindsym --input-device=$PAD_DEVICE --no-repeat Return exec --no-startup-id $TOGGLE_BIN send"
fi

mkdir -p "$(dirname "$LOG")" "$FLAGDIR" "$(dirname "$SWAYBIND")"

# Quiet LED feedback on the AhaKey pad (same contract as nerd-dictation-toggle):
# breathing while the microphone is open, off otherwise.
pulse() {
  if [ -x "$AHAKEY" ]; then
    "$AHAKEY" pulse "$1" >/dev/null 2>&1 || true
  fi
}

notify() {
  notify-send -u low "Diktat" "$1" 2>/dev/null || true
}

mainpid() { systemctl --user show "$SERVICE" -p MainPID --value 2>/dev/null; }

bind_mic() {
  {
    echo '# Written by wayland-whisper-toggle on/off. Do not edit by hand.'
    echo "$BIND_CMD"
    if [ -n "$PAD_BIND_CMD" ]; then
      echo "$PAD_BIND_CMD"
    fi
  } > "$SWAYBIND"
  swaymsg -q "$BIND_CMD" 2>>"$LOG" || true
  if [ -n "$PAD_BIND_CMD" ]; then
    swaymsg -q "$PAD_BIND_CMD" 2>>"$LOG" || true
  fi
}

unbind_mic() {
  printf '%s\n' \
    '# wayland-whisper master off — Ctrl+Space and pad Enter go to the app.' > "$SWAYBIND"
  swaymsg -q 'unbindsym Ctrl+Space' 2>>"$LOG" || true
  if [ -n "$PAD_DEVICE" ]; then
    swaymsg -q "unbindsym --input-device=$PAD_DEVICE Return" 2>>"$LOG" || true
  fi
}

master_off() {
  date -Iseconds > "$FLAG"
  systemctl --user disable --now "$SERVICE" 2>>"$LOG" || true
  rm -f "$COOKIE"
  unbind_mic
  pulse off
  echo "wayland-whisper: off (Ctrl+Space and pad Enter go to the focused app)"
  notify "aus — Ctrl+Space ist frei"
}

master_on() {
  rm -f "$FLAG"
  systemctl --user enable --now "$SERVICE" >>"$LOG" 2>&1 || true
  bind_mic
  pulse off
  echo "wayland-whisper: on (Ctrl+Space is the mic; model loads ~15 s)"
  notify "an — Ctrl+Space ist das Mikro"
}

mic_state() {
  pid=$(mainpid)
  if [ -z "$pid" ] || [ "$pid" = "0" ]; then
    echo "service-off"
    return
  fi
  if pgrep -P "$pid" -x parec >/dev/null 2>&1; then
    echo "mic-on"
  else
    echo "mic-off"
  fi
}

wait_cookie() {
  i=0
  while [ ! -s "$COOKIE" ] && [ "$i" -lt 60 ]; do
    sleep 0.5
    i=$((i + 1))
  done
}

mic_toggle() {
  case "$(mic_state)" in
    service-off)
      systemctl --user start "$SERVICE" >>"$LOG" 2>&1 || true
      wait_cookie
      "$BIN" resume --cookie "$COOKIE" 2>>"$LOG" || true
      pulse breathing
      ;;
    mic-off)
      "$BIN" resume --cookie "$COOKIE" 2>>"$LOG" || true
      pulse breathing
      ;;
    mic-on)
      pid=$(mainpid)
      kill -USR1 "$pid" 2>>"$LOG" || true
      pulse off
      ;;
  esac
}

inject_enter() {
  if [ -p "$FIFO" ]; then
    printf e > "$FIFO"
  elif command -v wtype >/dev/null 2>&1; then
    wtype -k Return
  fi
}

# Pad Enter: stop the dictation, let the pending phrase be delivered
# (transcribe + type), then press Enter — same flow as the old
# ahakey pad-enter.sh ("wait out Whisper/wtype, close the mic, then Enter").
send_phrase() {
  if [ -f "$FLAG" ]; then
    inject_enter
    exit 0
  fi
  if [ "$(mic_state)" = "mic-on" ]; then
    pid=$(mainpid)
    if [ -n "$pid" ] && [ "$pid" != "0" ]; then
      kill -USR1 "$pid" 2>>"$LOG" || true
      # Wait until the daemon has delivered the pending phrase and closed the
      # microphone, so Enter cannot land before the typed text (max ~60 s).
      i=0
      while [ "$(mic_state)" = "mic-on" ] && [ "$i" -lt 300 ]; do
        sleep 0.2
        i=$((i + 1))
      done
    fi
  fi
  pulse off
  # Belt and braces: wait out any wtype burst.
  i=0
  while pgrep -x wtype >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -gt 100 ] && break
    sleep 0.05
  done
  inject_enter
  exit 0
}

case "${1:-}" in
  on|enable) master_on ;;
  off|disable) master_off ;;
  master|toggle)
    if [ -f "$FLAG" ]; then master_on; else master_off; fi
    ;;
  mic) mic_toggle ;;
  send) send_phrase ;;
  status)
    if [ -f "$FLAG" ]; then echo "master: off"; else echo "master: on"; fi
    systemctl --user is-enabled "$SERVICE" 2>/dev/null || true
    systemctl --user is-active "$SERVICE" 2>/dev/null || true
    echo "mic: $(mic_state)"
    pid=$(mainpid)
    if [ -n "$pid" ] && [ "$pid" != "0" ]; then
      echo "pid: $pid  state: $(ps -o stat= -p "$pid" 2>/dev/null || echo gone)"
    else
      echo "pid: none"
    fi
    ;;
  ""|mic-toggle) mic_toggle ;;
  *)
    echo "usage: wayland-whisper-toggle {on|off|master|mic|send|status}" >&2
    exit 2
    ;;
esac
